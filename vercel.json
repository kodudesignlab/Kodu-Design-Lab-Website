{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(images|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "kodu-design-lab.vercel.app"
        }
      ],
      "destination": "https://www.kodudesignlab.com/$1",
      "permanent": true
    }
  ]
}
